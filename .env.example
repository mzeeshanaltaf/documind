# Copy to .env.local (root) and fill in. Both web/ and api/ read the root .env.local.
# Never commit real values — this repo is public.

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres URL with Prisma-style params; both apps normalize it. Local dev: ?schema=documind_dev, prod: ?schema=documind
DATABASE_URL=

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# API key for chat, routing and embeddings
OPENAI_API_KEY=
# Model for answer synthesis (e.g. gpt-6-luna)
OPENAI_CHAT_MODEL=
# Model for the orchestrator/router structured call (e.g. gpt-6-luna)
OPENAI_ROUTER_MODEL=
# Embedding model (e.g. text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=
# Embedding dimension; must match the pgvector column (1536)
OPENAI_EMBEDDING_DIM=
# Default tier for chat: standard | flex | auto
OPENAI_CHAT_SERVICE_TIER=
# Default tier for ingestion classify/summary: standard | flex | auto
OPENAI_BACKGROUND_SERVICE_TIER=
# Optional: monthly allowance for a user an admin hasn't customised (defaults 25 / 200000).
# Platform admins aren't limited. Admins change a user's limits under /admin/users.
# DEFAULT_MESSAGE_QUOTA=25
# DEFAULT_TOKEN_QUOTA=200000

# ─── App / auth ──────────────────────────────────────────────────────────────
# Better Auth signing secret (python -c "import secrets;print(secrets.token_urlsafe(48))")
BETTER_AUTH_SECRET=
# Public base URL Better Auth runs on (http://localhost:3000 locally)
BETTER_AUTH_URL=
# Public base URL of the web app, exposed to the browser
NEXT_PUBLIC_APP_URL=
# Server-only: FastAPI base URL the BFF proxy calls (http://localhost:8000 locally)
API_BASE_URL=
# Server-only: shared service key sent as X-API-Key from the BFF to FastAPI
DOCUMIND_API_KEY=
# Comma-separated emails granted role=admin on sign-up/login
PLATFORM_ADMIN_EMAILS=

# ─── Google OAuth ────────────────────────────────────────────────────────────
# OAuth client ID (redirect: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
# OAuth client secret
GOOGLE_CLIENT_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Resend API key for OTP / invitation emails
RESEND_API_KEY=
# Sender, e.g. DocuMind <noreply@your-verified-domain> (domain must be verified in Resend).
# Write it UNQUOTED: hosting dashboards pass quotes through and Resend rejects the `from` (422).
# Also needed at build time (static auth pages show the sender address).
RESEND_FROM_EMAIL=

# ─── Object storage (MinIO / S3) ─────────────────────────────────────────────
# S3 endpoint (http://localhost:9000 for local MinIO)
S3_ENDPOINT=
# S3 region (MinIO accepts us-east-1)
S3_REGION=
# Private bucket for uploaded PDFs
S3_BUCKET=
# Access key (also the local MinIO root user)
S3_ACCESS_KEY=
# Secret key (also the local MinIO root password)
S3_SECRET_KEY=
# true for MinIO (path-style addressing)
S3_FORCE_PATH_STYLE=

# ─── API request logs ────────────────────────────────────────────────────────
# Optional: every /v1 request is logged to api_request_logs (viewer: <api>/v1/logs/ui, asks for
# DOCUMIND_API_KEY). Defaults: enabled, rows pruned after 30 days.
# REQUEST_LOG_ENABLED=true
# REQUEST_LOG_RETENTION_DAYS=30

# ─── Contact form (n8n + Upstash) ────────────────────────────────────────────
# n8n webhook that receives contact-form submissions
N8N_CONTACT_WEBHOOK_URL=
# Key sent as x-api-key to the n8n webhook
N8N_API_KEY=
# Upstash Redis REST URL for rate limiting
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token
UPSTASH_REDIS_REST_TOKEN=

# ─── Deployment (Coolify) ────────────────────────────────────────────────────
# Root-access Coolify token for one-time provisioning (not read by the app)
COOLIFY_API_TOKEN_ROOT=
# Deploy-scoped Coolify token for GitHub Actions auto-deploy
COOLIFY_API_TOKEN=
# Coolify instance URL (deploy API base); also a GitHub repo secret
COOLIFY_BASE_URL=

# ─── Analytics (Umami) ───────────────────────────────────────────────────────
# Umami tracker script URL (needed at build time)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# Umami website ID (needed at build time)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Evaluation harness (evaluation/; see docs/plan/eval/README.md › Environment) ───
# Eval DB: same Postgres, own schema. Local: ?schema=documind_eval_dev, prod: ?schema=documind_eval
EVAL_DATABASE_URL=
# DocuMind's Better Auth schema; admins are checked against its "user" table (documind_dev / documind)
EVAL_AUTH_SCHEMA=
# Server-only: eval API base URL the eval web's BFF calls (http://localhost:8100 locally)
EVAL_API_URL=
# Server-only: service key the eval BFF sends as X-API-Key to the eval API
EVAL_API_KEY=
# Eval web's own Better Auth secret (E5). The eval web also reads DATABASE_URL (sign-in on DocuMind's
# auth tables, search_path = EVAL_AUTH_SCHEMA), GOOGLE_CLIENT_ID/SECRET and NEXT_PUBLIC_APP_URL
# (DocuMind's URL, for "Forgot password"; build-time)
EVAL_BETTER_AUTH_SECRET=
# Eval web's Better Auth base URL and public URL (http://localhost:3100 locally)
EVAL_BETTER_AUTH_URL=
EVAL_PUBLIC_URL=
# DocuMind API the harness evaluates (http://localhost:8000 locally); uses DOCUMIND_API_KEY
DOCUMIND_API_URL=
# DocuMind user ids printed by `uv run python -m scripts.bootstrap_service_users` (evaluation/api)
EVAL_SERVICE_USER_ID=
EVAL_PROBE_USER_ID=
# Claude judge (E4)
ANTHROPIC_API_KEY=
# Optional tuning (defaults shown): concurrent DocuMind calls, judge calls, Anthropic RPM, worker slots
# EVAL_DOCUMIND_CONCURRENCY=2
# EVAL_JUDGE_CONCURRENCY=4
# EVAL_ANTHROPIC_MAX_RPM=50
# EVAL_WORKER_SLOTS=4
# Local only: park judge/generation calls for Claude Code to answer instead of calling Anthropic
# EVAL_JUDGE_MODE=offline
# EVAL_OFFLINE_POLL_S=15

# ─── Office (office/; see docs/plan/office/README.md › Environment) ──────────
# The office also reads DATABASE_URL (sign-in on DocuMind's auth tables), API_BASE_URL +
# DOCUMIND_API_KEY (its BFF), GOOGLE_CLIENT_ID/SECRET, UPSTASH_REDIS_REST_URL/TOKEN (the shared
# chat limit) and NEXT_PUBLIC_APP_URL (DocuMind's URL; build-time).
# Office's own Better Auth secret (required in production; never DocuMind's BETTER_AUTH_SECRET)
OFFICE_BETTER_AUTH_SECRET=
# Office's Better Auth base URL and public URL (http://localhost:3200 locally)
OFFICE_BETTER_AUTH_URL=
OFFICE_PUBLIC_URL=
# DocuMind's Better Auth schema (documind_dev / documind)
OFFICE_AUTH_SCHEMA=
# The office's own tables, created by office/scripts/migrate.mjs (documind_office_dev / documind_office)
OFFICE_DB_SCHEMA=
# Optional (O10): Umami website id for the office (build-time)
# NEXT_PUBLIC_OFFICE_UMAMI_WEBSITE_ID=
