data: [{"n": 6, "document_id": "338502cf-0b94-43cb-ab74-e23975ed2c1d", "chunk_id": "c74d3708-7202-404c-97bf-0bd18ad5f8e2", "doc_code": "SIM-HR-101", "title": "Pakistan HR Manual (Lahore)", "section_number": "A", "section_title": "Key Terms Summary and Acknowledgement", "section_path": ["Appendices", "Appendix A – Key Terms Summary and Acknowledgement"], "page_start": 30, "page_end": 30, "snippet": "Appendix A – Key Terms Summary and Acknowledgement | Item | Summary | | --- | --- | | Employer | Simtora Technologies (Pvt.) Limited | | Hours | Mon–Fri, 8 h/day, core 10:00–15:00 PKT | | Probation | 3 months, extendable once by up to 3 months; 15 days' notice | | Pay | Monthly,…", "highlight_text": "Appendix A – Key Terms Summary and Acknowledgement\n\n| Item | Summary |\n| --- | --- |\n| Employer | Simtora Technologies (Pvt.) Limited |\n| Hours | Mon–Fri, 8 h/day, core 10:00–15:00 PKT |\n| Probation | 3 months, extendable once by up to 3 months; 15 days' notice |\n| Pay | Monthly, last working day, bank transfer, PKR |\n| Annual leave / casual / sick | 20 / 10 / 10 days |\n| Maternity / partner leave | 12 weeks / 6 weeks, full pay |\n| Public holidays | As notified, about 14–16, plus 2 days for other faiths |\n| Notice | 1 month (both sides) after confirmation |\n| Provident fund | 10% employee, 10% employer |\n| Harassment | Inquiry Committee; 30-day inquiry; appeal to Ombudsman |"}, {"n": 8, "document_id": "e036d9ba-81a8-43f6-b894-4e1ada5a1ea3", "chunk_id": "16dd8751-4478-463a-8011-cae5efba0085", "doc_code": "SIM-HR-002", "title": "Global People Supplement to the Human Resources Policy Manual", "section_number": "3.2", "section_title": "Key Entitlements Compared", "section_path": ["Part 3 – Country Manuals and Comparison", "3.2 Key Entitlements Compared"], "page_start": 33, "page_end": 34, "snippet": "3.2 Key Entitlements Compared This table is a summary only. The Country HR Manual and the law govern. Figures are for full-time employees after any qualifying period. 3.2 Key Entitlements Compared | Item | United States | Pakistan | Germany | France | Australia | United Kingdom…", "highlight_text": "3.2 Key Entitlements Compared\n\nThis table is a summary only. The Country HR Manual and the law govern. Figures are for full-time employees after any qualifying period.\n\n3.2 Key Entitlements Compared\n\n| Item | United States | Pakistan | Germany | France | Australia | United Kingdom |\n| --- | --- | --- | --- | --- | --- | --- |\n| Standard week | 40 h (Mon– Fri) | 40 h (legal max 48 h) | 40 h (8 h/day; avg. max 8 h, 10 h peak) | 35 h legal; 38.5 h with extra days off, or annual day-count for eligible autonomous cadres | 38 h |  |\n| Probation | 90 days (+30) | 3 months (+3) | 6 months | 4 months for cadres (3 for technicians), renewable once where allowed | 6 months | 3 months (up to 6) |\n| Annual leave | PTO 15 / 20 / 25 days | 20 days annual + 10 days casual | 30 days | 25 working days + RTT days where applicable | 25 days (20 statutory + 5) |  |\n| Public holidays | 11 + 2 floating | About 14–16 as notified | 10 (Berlin) + Dec 24 and Dec 31 | 10 paid (Whit Monday is the solidarity day) | Up to 11 (NSW) | 8 (England and Wales) |"}]

